# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real keys.
# Variables already set in your shell take precedence over this file.

# Tapetide personal token (https://tapetide.com/settings/tokens) — stock fundamentals
TAPETIDE_TOKEN=tpt_rt_your_token_here

# OpenRouter API key (https://openrouter.ai/keys) — AI analysis.
# Not needed when config/app.json "ai.base_url" points at a local LM Studio / Ollama server.
OPENROUTER_API_KEY=sk-or-your_key_here
