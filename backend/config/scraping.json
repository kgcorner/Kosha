{
  "source": "mfdata",
  "homepage_url": "https://mfdata.in/",
  "categories": [
    { "category": "Large Cap", "url": "https://mfdata.in/api/v1/schemes?category=Large%20Cap&plan_type=direct&exclude_fmp=true" },
    { "category": "Mid Cap", "url": "https://mfdata.in/api/v1/schemes?category=Mid%20Cap&plan_type=direct&exclude_fmp=true" },
    { "category": "Small Cap", "url": "https://mfdata.in/api/v1/schemes?category=Small%20Cap&plan_type=direct&exclude_fmp=true" },
    { "category": "Flexi Cap", "url": "https://mfdata.in/api/v1/schemes?category=Flexi%20Cap&plan_type=direct&exclude_fmp=true" },
    { "category": "ELSS", "url": "https://mfdata.in/api/v1/schemes?category=ELSS&plan_type=direct&exclude_fmp=true" },
    { "category": "Value Oriented", "url": "https://mfdata.in/api/v1/schemes?category=Value&plan_type=direct&exclude_fmp=true" },
    { "category": "Thematic", "url": "https://mfdata.in/api/v1/schemes?category=Thematic&plan_type=direct&exclude_fmp=true" }
